{
    "type": "uta-robot",
    "target": "esp32s3",
    "builds": [
        {
            "name": "uta-robot",
            "wake_word": "wn9_hilili_tts",
            "sdkconfig_append": [
                "CONFIG_BOARD_TYPE_UTA_ROBOT=y",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024",
                "CONFIG_MP4_EXTRACTOR_SUPPORT=y",
                "CONFIG_VIDEO_DECODER_SW_H264_SUPPORT=y",
                "CONFIG_VIDEO_DECODER_SW_MJPEG_SUPPORT=y"
            ]
        }
    ]
}
